{
  "name": "toggly-cloudflare-worker",
  "version": "0.3.1",
  "description": "Cloudflare Worker that applies Toggly feature flag gating at the edge.",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:runtime": "node --test tests/runtime/worker-html-rewriter.integration.mjs",
    "test:all": "npm run test:coverage && npm run test:runtime",
    "clean": "rm -rf .wrangler dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "overrides": {
    "minimatch": "^10.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "cloudflare",
    "workers",
    "edge"
  ]
}
