{
  "name": "toggly-cloudflare-worker",
  "version": "0.1.0",
  "description": "Cloudflare Worker that applies Toggly feature flag gating at the edge.",
  "license": "MIT",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf .wrangler dist"
  },
  "dependencies": {
    "@ops-ai/toggly-client-core": "^0.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.38.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "toggly",
    "feature-flags",
    "cloudflare",
    "workers",
    "edge"
  ]
